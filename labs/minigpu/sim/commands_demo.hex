// ==============================================================================
// EcrioniX MiniGPU - Example Drawing Command Hex Stream
// Multi-word 32-bit Command Packets
// Format:
// Word 0: [31:28]=OPCODE, [27:24]=FLAGS, [23:16]=COLOR_R, [15:8]=COLOR_G, [7:0]=COLOR_B
// Word 1: [31:16]=PARAM_A (X0/XC), [15:0]=PARAM_B (Y0/YC)
// Word 2: [31:16]=PARAM_C (X1/RADIUS), [15:0]=PARAM_D (Y1)
// Word 3: [31:16]=PARAM_E (X2), [15:0]=PARAM_F (Y2) [Only for Triangle]
// ==============================================================================

// --- Packet 1: CLEAR SCREEN to Dark Navy (#0B1120) ---
// OPCODE=0x1, Color=0x0B, 0x11, 0x20
100B1120

// --- Packet 2: DRAW RECTANGLE at (20,20) to (60,50) in Sky Blue (#38BDF8) ---
// Word 0: OPCODE=0x2, Color=0x38, 0xBD, 0xF8
2038BDF8
// Word 1: X0=20 (0x0014), Y0=20 (0x0014)
00140014
// Word 2: X1=60 (0x003C), Y1=50 (0x0032)
003C0032

// --- Packet 3: DRAW CIRCLE at Center=(100,60), Radius=25 in Coral Red (#F43F5E) ---
// Word 0: OPCODE=0x3, Color=0xF4, 0x3F, 0x5E
30F43F5E
// Word 1: XC=100 (0x0064), YC=60 (0x003C)
0064003C
// Word 2: Radius=25 (0x0019), Param_D=0
00190000

// --- Packet 4: DRAW TRIANGLE at (40,110), (80,45), (120,110) in Emerald (#10B981) ---
// Word 0: OPCODE=0x4, Color=0x10, 0xB9, 0x81
4010B981
// Word 1: X0=40 (0x0028), Y0=110 (0x006E)
0028006E
// Word 2: X1=80 (0x0050), Y1=45 (0x002D)
0050002D
// Word 3: X2=120 (0x0078), Y2=110 (0x006E)
0078006E

// --- Packet 5: FLIP FRAMEBUFFER ---
// OPCODE=0x5
50000000
