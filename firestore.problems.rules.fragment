// MERGE these match blocks into your existing Cloud Firestore rules.
// Do NOT deploy this file alone — it is incomplete vs production (community, course requests, etc.).
//
// Collections used by /problems/:
//   users/{uid}.completedChallenges, users/{uid}.problemStats
//   leaderboard/{uid}
//   problemAttempts/{uid}_{slug}

    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /problemAttempts/{attemptId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Ensure users/{uid} already allows the owner to update:
    //   completedChallenges (array), problemStats (map), displayName, photoURL
