// MERGE into production Firestore rules (already applied live 2026-08-08).
// First get() on a missing attempt doc must allow resource == null.

    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /problemAttempts/{attemptId} {
      allow get: if request.auth != null && (
        resource == null || resource.data.uid == request.auth.uid
      );
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && attemptId == request.auth.uid + '_' + request.resource.data.slug;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
