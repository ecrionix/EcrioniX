rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    match /paymentRequests/{doc} {
      allow read: if request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2' || request.auth.uid == resource.data.userId;
      allow update: if request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2';
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /users/{uid} {
      allow read: if request.auth.uid == uid || request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2';
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid || request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2';
      allow delete: if request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2';
    }

    match /chats/{chatUserId} {
      allow read, create, update: if request.auth.uid == chatUserId || request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2';

      match /messages/{messageId} {
        allow read, create: if request.auth.uid == chatUserId || request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2';
      }
    }

    match /communityPosts/{postId} {
      allow read: if request.auth != null && (
        request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvedCourses.size() > 0)
      );
      allow create: if request.auth != null &&
        request.resource.data.authorId == request.auth.uid &&
        (
          request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvedCourses.size() > 0)
        );
      allow update: if request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2' ||
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'pollVotes']) &&
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approvedCourses.size() > 0));
      allow delete: if request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2';
    }

    match /dailyChallenges/{challengeId} {
      // Open to any signed-in user — no course approval required.
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2';

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2' ||
          (request.auth != null &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes']));
        allow delete: if request.auth.uid == 'aUH4VdmtHKZQbFqXJqCOcQRNVOG2';
      }
    }
  

    // EcrioniX Problems
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // First get() on a missing attempt doc must be allowed (resource is null).
    match /problemAttempts/{attemptId} {
      allow get: if request.auth != null && (
        resource == null || resource.data.uid == request.auth.uid
      );
      allow list: if false;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && attemptId == request.auth.uid + '_' + request.resource.data.slug;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}